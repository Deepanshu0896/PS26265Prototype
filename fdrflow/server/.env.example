# FDRFlow Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Settings:
# For instant zero-config evaluation, use 'sqlite' (default)
DB_DIALECT=sqlite
DB_STORAGE=./fdrflow.sqlite

# For production MySQL deployment:
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=fdrflow
# DB_USER=root
# DB_PASSWORD=your_mysql_password

# Authentication
JWT_SECRET=fdrflow_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Proactive Email Alert Notifications (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
